<UserControl x:Class="CyTool.Views.BruteForceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="600">
    <Grid Background="#FF202124">
        <StackPanel Orientation="Vertical" Margin="20">
            <TextBlock Text="Brute Force Tool" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="White"
                       Margin="0,0,0,20" />
            <TextBlock Text="Target URL:" Foreground="White"/>
            <TextBox Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}"
                     Width="300" Margin="0,0,0,10" />
            <TextBlock Text="Username:" Foreground="White"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                     Width="300" Margin="0,0,0,10" />

            <!-- Advanced Settings Section -->
            <Expander Header="Advanced Settings" Foreground="White" IsExpanded="False" Margin="0,10,0,10">
                <StackPanel Orientation="Vertical" Margin="10">
                    <TextBlock Text="Request Method:" Foreground="White"/>
                    <TextBox Text="{Binding RequestMethod, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,0,10" />
                    <TextBlock Text="Username Parameter:" Foreground="White"/>
                    <TextBox Text="{Binding UsernameParam, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,0,10" />
                    <TextBlock Text="Password Parameter:" Foreground="White"/>
                    <TextBox Text="{Binding PasswordParam, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,0,10" />
                    <TextBlock Text="Login Parameter:" Foreground="White"/>
                    <TextBox Text="{Binding LoginParam, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,0,10" />
                    <TextBlock Text="Success Indicator:" Foreground="White"/>
                    <TextBox Text="{Binding SuccessIndicator, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,0,10" />
                    <TextBlock Text="Failure Indicator:" Foreground="White"/>
                    <TextBox Text="{Binding FailureIndicator, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,0,10" />
                    <TextBlock Text="Additional Query:" Foreground="White"/>
                    <TextBox Text="{Binding AdditionalQuery, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,0,10" />
                    <TextBlock Text="Logout URL:" Foreground="White"/>
                    <TextBox Text="{Binding LogoutUrl, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,0,10" />
                </StackPanel>
            </Expander>
            <!-- End Advanced Settings -->

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Start Brute Force"
                        Style="{StaticResource CyberButton}"
                        Command="{Binding StartBruteForceCommand}"
                        Margin="0,0,10,0"
                        Width="150" />
                <Button Content="Stop"
                        Style="{StaticResource CyberButton}"
                        Command="{Binding StopBruteForceCommand}"
                        Width="100" />
            </StackPanel>
            <TextBlock Text="Output:" 
                       FontWeight="Bold" 
                       Foreground="White"/>
            <TextBox Text="{Binding OutputLog, UpdateSourceTrigger=PropertyChanged}"
                     Width="500" 
                     Height="200" 
                     IsReadOnly="True" 
                     VerticalScrollBarVisibility="Auto" 
                     TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
