<UserControl x:Class="CyTool.Views.DataLeakCheckerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#FF202124"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Input + Button -->
            <RowDefinition Height="Auto"/>
            <!-- ProgressBar -->
            <RowDefinition Height="*"/>
            <!-- Results -->
            <RowDefinition Height="Auto"/>
            <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Data Leak Checker"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Email + Check -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Email:"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="16"
                       Margin="0,0,10,0"/>
            <TextBox Width="250"
                     Height="30"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Background="#FF2A2D31"
                     Foreground="White"
                     BorderBrush="Gray"
                     BorderThickness="1"
                     Padding="5"
                     Margin="0,0,10,0"/>
            <Button Content="Check"
                    Style="{StaticResource CyberButton}"
                    Command="{Binding CheckCommand}"
                    Width="137"
                    Height="30"/>
        </StackPanel>

        <!-- Busy indicator -->
        <ProgressBar Grid.Row="2"
                     Height="6"
                     Margin="0,15,0,15"
                     IsIndeterminate="True">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Foreground" Value="#FF4285F4"/>
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Results grid -->
        <Border Grid.Row="3"
                Background="#FF2A2D31"
                CornerRadius="8"
                Padding="5">
            <DataGrid ItemsSource="{Binding Breaches}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowBackground="#FF2C2F33"
                      AlternatingRowBackground="#FF202124"
                      Foreground="White"
                      BorderThickness="0"
                      RowHeight="30">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF2A2D31"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="30"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="2*" />
                    <DataGridTextColumn Header="Bucket"
                                        Binding="{Binding Bucket}"
                                        Width="1.5*" />
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding Date, StringFormat=d}"
                                        Width="1*" />
                    <DataGridTextColumn Header="Size"
                                        Binding="{Binding SizeDisplay}"
                                        Width="1*" />
                    <DataGridTextColumn Header="System ID"
                                        Binding="{Binding SystemId}"
                                        Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status message -->
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   HorizontalAlignment="Center"
                   Foreground="LightGray"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>
