<Page x:Class="CyTool.Views.DdosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CyTool.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DdosPage">

    <Grid Background="#FF2C2E33">
        <Label Content="DDOS TOOL" HorizontalAlignment="Center" Height="42" Margin="0,25,0,0" VerticalAlignment="Top" Width="167" Background="#FF2C2E33" Foreground="White" FontSize="28" FontWeight="Bold"/>
        <TextBox x:Name="TextBox" HorizontalAlignment="Left" Height="21" Margin="240,313,0,0" TextWrapping="Wrap" Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="330" FontWeight="Bold"/>
        <Button x:Name="SubmitButton" Content="Button" HorizontalAlignment="Left" Height="36" Margin="240,370,0,0" VerticalAlignment="Top" Width="180" Background="#FF4285F4" Foreground="White" FontWeight="Bold" FontSize="15" BorderBrush="White" BorderThickness="0" Command="{Binding SubmitDdos}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <ListBox HorizontalAlignment="Center" Height="185" Margin="0,115,0,0" VerticalAlignment="Top" Width="446" ItemsSource="{Binding RequestLogs}"/>
        <Label Content="Link:" HorizontalAlignment="Left" Height="29" Margin="177,309,0,0" VerticalAlignment="Top" Width="45" Foreground="White" FontWeight="Bold" FontSize="15"/>
        <TextBox x:Name="CountTextBox" HorizontalAlignment="Left" Height="21" Margin="240,339,0,0" TextWrapping="Wrap" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="330" FontWeight="Bold"/>
        <Label Content="Count:" HorizontalAlignment="Left" Height="29" Margin="177,335,0,0" VerticalAlignment="Top" Width="58" Foreground="White" FontWeight="Bold" FontSize="15"/>


    </Grid>
</Page>
