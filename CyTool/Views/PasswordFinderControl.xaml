<Page x:Class="CyTool.Views.PasswordFinderControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CyTool.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PasswordFinderControl">

    <Grid Background="#FF202124">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" >
            <Label Content="Password Finder"
                   FontSize="28"
                   Foreground="White"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>
            <Button Content="Create a secure password"
                    Style="{StaticResource CyberButton}"
                    Command="{Binding GeneratePasswordCommand}"
                    Width="289"
                    Height="50"
                    HorizontalAlignment="Center"/>
            <Label Content="{Binding PasswordLabel}"
                   FontSize="18"
                   Foreground="White"
                   FontWeight="Bold"
                   Width="360"
                   HorizontalAlignment="Center"
                   Margin="100,20,0,0"/>
            
            <Label Content="The password is automatically copied to the clipboard."
                   FontSize="14"
                   Foreground="LightGray"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>
